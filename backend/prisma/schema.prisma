generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  label String
  scope String

  // A category has diffrent ingredients
  Ingredients Ingredient[]
  @@map("category")
}

model Ingredient {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  display         String
  category_id     Int // references category(id)
  is_staple       Boolean  @default(false)
  derives_from_id Int? // tuorli -> uova, references ingredient(id)
  states          String[] @default([])

  // An ingredient has only a category (in this project)
  category          Category           @relation(fields: [category_id], references: [id])
  recipeIngredients RecipeIngredient[]

  deriverFrom Ingredient?  @relation("Derivations", fields: [derives_from_id], references: [id])
  derived     Ingredient[] @relation("Derivations")
  @@map("ingredient")
}

model Recipe {
  id           Int      @id
  title        String
  cuisine      String
  servings     Int // check if is > 0
  prep_time    Int // check if is > 0
  difficulty   String // check if is ["easy", "medium", "hard"]
  reviewed     Boolean  @default(false)
  instructions String[] @default([])
  tags         String[] @default([])

  recipeIngredients RecipeIngredient[]
  @@map("recipe")
}

model RecipeIngredient {
  id             Int @id @default(autoincrement()) //surrogate key
  recipe_id      Int // references recipe(id)
  ingredient_id  Int // references ingredient(id)
  as_written     String
  quantity       String
  required_state String?

  recipe     Recipe    @relation(fields: [recipe_id], references: [id])
  ingredient Ingredient @relation(fields: [ingredient_id], references: [id])

  @@index([recipe_id,ingredient_id]) 
  @@index([ingredient_id]) // index for the retriver
  @@map("recipe_ingredient")
}
